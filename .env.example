# === Supabase ===
# หาได้จาก Supabase Dashboard > Project Settings > API
# NEXT_PUBLIC_* คือ prefix พิเศษของ Next.js ที่บอกว่าตัวแปรนี้
# "จะถูก bundle ไปฝั่ง browser ได้" (ไม่ใช่ secret ที่ต้องปิดลับ)
# ตัวแปรที่ไม่มี NEXT_PUBLIC_ นำหน้า จะอยู่ฝั่ง server เท่านั้น

# URL ของ Supabase project (เช่น https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://kkdtzdhcsnyqlexwvfmk.supabase.co

# Anon (public) key — ปลอดภัยที่จะ expose ฝั่ง client เพราะสิทธิ์การเข้าถึง
# ข้อมูลจริง ๆ ถูกควบคุมด้วย Row Level Security (RLS) policies บน Supabase
# ไม่ใช่ด้วยการปิดบัง key นี้
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtrZHR6ZGhjc255cWxleHd2Zm1rIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzOTgwNDIsImV4cCI6MjEwNDk3NDA0Mn0.Eyg2k-oL32MSjWMEZlbhv_BxRcTaH49EqegxtwsddOc
